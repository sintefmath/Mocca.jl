{
  "format": "mocca-process",
  "version": 1,
  "name": "Haghpanah et al. (2013), four-step VSA",
  "gas": {
    "components": [
      "CO2",
      "N2"
    ],
    "molar_masses": {
      "CO2": 0.04401,
      "N2": 0.028
    },
    "heat_capacities": {
      "CO2": 697.5687,
      "N2": 1096.4
    },
    "viscosity": 1.72e-5,
    "density": 1.22638310956,
    "diffusivity": 1.6e-5
  },
  "feed": {
    "composition": {
      "CO2": 0.15,
      "N2": 0.85
    },
    "temperature": 298.15,
    "pressure": 100000.0,
    "light_product": {
      "CO2": 1.0e-10,
      "N2": 0.9999999999
    }
  },
  "adsorbents": {
    "zeolite 13X": {
      "format": "mocca-adsorbent",
      "version": 1,
      "name": "zeolite 13X",
      "reference": "Haghpanah et al., Ind. Eng. Chem. Res. 52 (2013) 4249, doi:10.1021/ie302658y. Capacities per m³ of adsorbent.",
      "density": 1130.0,
      "heat_capacity": 1070.0,
      "particle_diameter": 0.002,
      "particle_porosity": 0.35,
      "tortuosity": 3.0,
      "adsorbed_heat_capacity": {
        "CO2": 697.5687,
        "N2": 1096.4
      },
      "isotherm": {
        "type": "dual_site_langmuir",
        "reference_temperature": 298.15,
        "basis": "volume",
        "components": {
          "CO2": {
            "qsb": 3489.44,
            "b0": 8.65e-7,
            "dUb": -36641.21,
            "qsd": 2872.35,
            "d0": 2.63e-8,
            "dUd": -35690.66
          },
          "N2": {
            "qsb": 6613.551,
            "b0": 2.5e-6,
            "dUb": -15800.0
          }
        }
      }
    }
  },
  "columns": {
    "column_1": {
      "length": 1.0,
      "radius": 0.1445,
      "outer_radius": 0.162,
      "porosity": 0.37,
      "axial_conductivity": 0.0903,
      "wall": {
        "density": 7800.0,
        "heat_capacity": 502.0,
        "conductivity": 16.0
      },
      "inner_heat_transfer": 8.6,
      "outer_heat_transfer": 2.5,
      "ambient_temperature": 298.15
    }
  },
  "units": [
    {
      "name": "Bed",
      "type": "fixed_bed",
      "adsorbent": "zeolite 13X",
      "column": "column_1",
      "ncells": 30,
      "thermal": "with_wall",
      "dispersion_velocity": "adsorption"
    }
  ],
  "devices": [
    {
      "name": "V_feed",
      "role": "feed",
      "at": [
        "Bed",
        "bottom"
      ]
    },
    {
      "name": "V_product",
      "role": "product",
      "at": [
        "Bed",
        "top"
      ]
    },
    {
      "name": "V_vacuum",
      "role": "extract",
      "at": [
        "Bed",
        "bottom"
      ]
    }
  ],
  "cycle": {
    "steps": [
      {
        "type": "pressurise",
        "duration": 15.0,
        "source": "feed"
      },
      {
        "type": "adsorb",
        "duration": 15.0,
        "velocity": 1.0
      },
      {
        "type": "blowdown",
        "duration": 30.0,
        "to": 20000.0,
        "through": "top"
      },
      {
        "type": "evacuate",
        "duration": 40.0,
        "to": 10000.0,
        "through": "bottom"
      }
    ]
  },
  "time_stepping": {
    "max_dt": 1.0,
    "first_dt": 0.05,
    "keep_step_pattern": "auto"
  },
  "options": {
    "key_component": "CO2",
    "ambient_pressure": 100000.0,
    "pump_efficiency": 0.72,
    "heat_capacity_ratio": 1.4,
    "ramp_rate": 0.5
  },
  "variables": [
    {
      "name": "t_ads",
      "places": [
        {
          "step": "adsorption",
          "field": "duration"
        }
      ],
      "bounds": [
        20.0,
        100.0
      ],
      "description": "adsorption time [s]"
    },
    {
      "name": "t_bd",
      "places": [
        {
          "step": "blowdown",
          "field": "duration"
        }
      ],
      "bounds": [
        30.0,
        200.0
      ],
      "description": "blowdown time [s]"
    },
    {
      "name": "t_evac",
      "places": [
        {
          "step": "evacuation",
          "field": "duration"
        }
      ],
      "bounds": [
        30.0,
        200.0
      ],
      "description": "evacuation time [s]"
    },
    {
      "name": "P_I",
      "places": [
        {
          "step": "blowdown",
          "field": "to"
        }
      ],
      "bounds": [
        5000.0,
        50000.0
      ],
      "description": "intermediate pressure [Pa]"
    },
    {
      "name": "P_L",
      "places": [
        {
          "step": "evacuation",
          "field": "to"
        }
      ],
      "bounds": [
        1000.0,
        50000.0
      ],
      "description": "low pressure [Pa]"
    },
    {
      "name": "v_feed",
      "places": [
        {
          "step": "adsorption",
          "field": "velocity"
        }
      ],
      "bounds": [
        0.1,
        2.0
      ],
      "description": "interstitial feed velocity [m/s]"
    }
  ]
}